fn vg:script/stop_cutscene
gamerule natural_regeneration true

scb obj add defeat deathCount
scb players set @a[team=player] defeat 0

scb players set #shop_unlock data 0
scb players set #progress data 3
scb players set #shop data 0
scb players set #armor data 0

tellraw @a {text='Maгазин разблокирован', color=green}
tellraw @a {text='Купите своё первое снаряжение', color=dark_red}

ex as @e[type=item, tag=!plot] at @s run tp @s @p[team=player]
