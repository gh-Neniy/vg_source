sm block_display[part, left_rotation=[0, 1, 0, 1], translation=[-0.5, 4.5, 2.5]] ~ ~ ~

sm block_display[side_part, left_rotation=[0.2706, -0.2706, 0.6533, 0.6533], translation=[0.495, 2.5, -5.5]] ~ ~ ~
