sm block_display[block=netherite_block, tag=wheel, tag=center, rotation=[-90, 90], tp_time=45] ~ ~ ~

sm block_display[block=iron_block, tag=wheel, tag=rod, tag=right_rod, rotation=[-90, 90], tp_time=45] ~ ~ ~
