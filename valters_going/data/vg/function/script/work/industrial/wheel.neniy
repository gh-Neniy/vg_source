sm block_display[block=iron_block, tag=wheel, tag=part, tag=right_part, rotation=[-90, 90], tp_time=45] ~ ~ ~

sm block_display[block=iron_block, tag=wheel, tag=side_part, tag=upper_right_part, rotation=[-90, 90], tp_time=45] ~ ~ ~
sm block_display[block=iron_block, tag=wheel, tag=side_part, tag=lower_left_part, rotation=[-90, 90], tp_time=45] ~ ~ ~
