sm block_display[block=iron_block, tag=wheel, tag=side_part, tag=lower_right_part, rotation=[-90, 90], tp_time=45] ~ ~ ~

// buckets
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=0, rotation=[-90, 90], tp_time=45] ~ ~ ~
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=1, rotation=[-90, 90], tp_time=45] ~ ~ ~
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=2, rotation=[-90, 90], tp_time=45] ~ ~ ~
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=3, rotation=[-90, 90], tp_time=45] ~ ~ ~
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=4, rotation=[-90, 90], tp_time=45] ~ ~ ~
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=5, rotation=[-90, 90], tp_time=45] ~ ~ ~
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=6, rotation=[-90, 90], tp_time=45] ~ ~ ~
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=7, rotation=[-90, 90], tp_time=45] ~ ~ ~
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=8, rotation=[-90, 90], tp_time=45] ~ ~ ~
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=9, rotation=[-90, 90], tp_time=45] ~ ~ ~
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=10, rotation=[-90, 90], tp_time=45] ~ ~ ~
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=11, rotation=[-90, 90], tp_time=45] ~ ~ ~

ex as @e[type=block_display, tag=wheel, tag=center] run data modify @s scale set [4.0, 1.0, 1.0]
ex as @e[type=block_display, tag=wheel, tag=rod] run data modify @s scale set [4.0, 1.0, 1.0]
ex as @e[type=block_display, tag=wheel, tag=part] run data modify @s scale set [5.0, 1.0, 1.0]
ex as @e[type=block_display, tag=wheel, tag=side_part] run data modify @s scale set [4.24264, 0.99, 1.0]

// rod rotation
ex as @e[type=block_display, tag=wheel, tag=upper_rod] run data modify @s left_rotation set [0, 1, 0, 1]
ex as @e[type=block_display, tag=wheel, tag=lower_rod] run data modify @s left_rotation set [0, 1, 0, 1]
ex as @e[type=block_display, tag=wheel, tag=left_rod] run data modify @s left_rotation set [0, 0, 1, 1]
ex as @e[type=block_display, tag=wheel, tag=right_rod] run data modify @s left_rotation set [0, 0, 1, 1]

// part rotation
ex as @e[type=block_display, tag=wheel, tag=upper_part] run data modify @s left_rotation set [0, 0, 1, 1]
ex as @e[type=block_display, tag=wheel, tag=lower_part] run data modify @s left_rotation set [0, 0, 1, 1]
ex as @e[type=block_display, tag=wheel, tag=left_part] run data modify @s left_rotation set [0, 1, 0, 1]
ex as @e[type=block_display, tag=wheel, tag=right_part] run data modify @s left_rotation set [0, 1, 0, 1]

// side part rotation
ex as @e[type=block_display, tag=wheel, tag=upper_right_part] run data modify @s left_rotation set [0.2706, -0.2706, 0.6533, 0.6533]
ex as @e[type=block_display, tag=wheel, tag=lower_left_part] run data modify @s left_rotation set [0.2706, -0.2706, 0.6533, 0.6533]
ex as @e[type=block_display, tag=wheel, tag=upper_left_part] run data modify @s left_rotation set [-0.2706, 0.2706, 0.6533, 0.6533]
ex as @e[type=block_display, tag=wheel, tag=lower_right_part] run data modify @s left_rotation set [-0.2706, 0.2706, 0.6533, 0.6533]

// bucket rotation
ex as @e[type=block_display, tag=wheel, tag=bucket, tag=0] run data modify @s left_rotation set [1, 0, 0, 1]
ex as @e[type=block_display, tag=wheel, tag=bucket, tag=1] run data modify @s left_rotation set [1, 0, 0, 1]

ex as @e[type=block_display, tag=wheel, tag=bucket, tag=2] run data modify @s left_rotation set [0.38268, 0.0, 0.0, 0.92388]

ex as @e[type=block_display, tag=wheel, tag=bucket, tag=3] run data modify @s left_rotation set [0, 0, 0, 1]
ex as @e[type=block_display, tag=wheel, tag=bucket, tag=4] run data modify @s left_rotation set [0, 0, 0, 1]

ex as @e[type=block_display, tag=wheel, tag=bucket, tag=5] run data modify @s left_rotation set [-0.38268, 0.0, 0.0, 0.92388]

ex as @e[type=block_display, tag=wheel, tag=bucket, tag=6] run data modify @s left_rotation set [-1, 0, 0, 1]
ex as @e[type=block_display, tag=wheel, tag=bucket, tag=7] run data modify @s left_rotation set [-1, 0, 0, 1]

ex as @e[type=block_display, tag=wheel, tag=bucket, tag=8] run data modify @s left_rotation set [-0.92388, 0.0, 0.0, 0.38268]

ex as @e[type=block_display, tag=wheel, tag=bucket, tag=9] run data modify @s left_rotation set [0, 0, 1, 0]
ex as @e[type=block_display, tag=wheel, tag=bucket, tag=10] run data modify @s left_rotation set [0, 0, 1, 0]

ex as @e[type=block_display, tag=wheel, tag=bucket, tag=11] run data modify @s left_rotation set [0.92388, 0.0, 0.0, 0.38268]

// [-0.5, -0.5, -0.5] run data modify @s
ex as @e[type=block_display, tag=wheel, tag=center] run data modify @s translation set [-3.5, -0.5, -0.5]

// rod position
ex as @e[type=block_display, tag=wheel, tag=left_rod] run data modify @s translation set [0.5, 0.5, -0.5]
ex as @e[type=block_display, tag=wheel, tag=right_rod] run data modify @s translation set [0.5, -4.5, -0.5]
ex as @e[type=block_display, tag=wheel, tag=upper_rod] run data modify @s translation set [-0.5, -0.5, -0.5]
ex as @e[type=block_display, tag=wheel, tag=lower_rod] run data modify @s translation set [-0.5, -0.5, 4.5]

// part position
ex as @e[type=block_display, tag=wheel, tag=upper_part] run data modify @s translation set [0.5, -2.5, -5.5]
ex as @e[type=block_display, tag=wheel, tag=lower_part] run data modify @s translation set [0.5, -2.5, 4.5]
ex as @e[type=block_display, tag=wheel, tag=right_part] run data modify @s translation set [-0.5, 4.5, 2.5]
ex as @e[type=block_display, tag=wheel, tag=left_part] run data modify @s translation set [-0.5, -5.5, 2.5]

// side part position
ex as @e[type=block_display, tag=wheel, tag=upper_right_part] run data modify @s translation set [0.495, 2.5, -5.5]
ex as @e[type=block_display, tag=wheel, tag=lower_left_part] run data modify @s translation set [0.495, -4.79289, 1.79289]
ex as @e[type=block_display, tag=wheel, tag=upper_left_part] run data modify @s translation set [0.495, -5.5, -2.5]
ex as @e[type=block_display, tag=wheel, tag=lower_right_part] run data modify @s translation set [0.495, 1.79289, 4.79289]

// bucket position
ex as @e[type=block_display, tag=wheel, tag=bucket, tag=0] run data modify @s translation set [-0.5, -5.5, -2.0]
ex as @e[type=block_display, tag=wheel, tag=bucket, tag=1] run data modify @s translation set [-0.5, -5.5, 1.0]

ex as @e[type=block_display, tag=wheel, tag=bucket, tag=2] run data modify @s translation set [-0.5, -4.35356, 3.64644]

ex as @e[type=block_display, tag=wheel, tag=bucket, tag=3] run data modify @s translation set [-0.5, -2.0, 5.5]
ex as @e[type=block_display, tag=wheel, tag=bucket, tag=4] run data modify @s translation set [-0.5, 1.0, 5.5]

ex as @e[type=block_display, tag=wheel, tag=bucket, tag=5] run data modify @s translation set [-0.5, 3.64644, 4.35355]

ex as @e[type=block_display, tag=wheel, tag=bucket, tag=6] run data modify @s translation set [-0.5, 5.5, 2.0]
