sm block_display[block=netherite_block, tag=wheel, tag=center, rotation=[-90, 90], tp_time=40] ~ ~ ~

sm block_display[block=iron_block, tag=wheel, tag=rod, tag=right_rod, rotation=[-90, 90], tp_time=40] ~ ~ ~
sm block_display[block=iron_block, tag=wheel, tag=rod, tag=left_rod, rotation=[-90, 90], tp_time=40] ~ ~ ~
sm block_display[block=iron_block, tag=wheel, tag=rod, tag=upper_rod, rotation=[-90, 0], tp_time=40] ~ ~ ~
sm block_display[block=iron_block, tag=wheel, tag=rod, tag=lower_rod, rotation=[-90, 0], tp_time=40] ~ ~ ~

sm block_display[block=iron_block, tag=wheel, tag=part, tag=upper_part, rotation=[-90, 90], tp_time=40] ~ ~ ~
sm block_display[block=iron_block, tag=wheel, tag=part, tag=lower_part, rotation=[-90, 90], tp_time=40] ~ ~ ~
sm block_display[block=iron_block, tag=wheel, tag=part, tag=left_part, rotation=[-90, 0], tp_time=40] ~ ~ ~
sm block_display[block=iron_block, tag=wheel, tag=part, tag=right_part, rotation=[-90, 0], tp_time=40] ~ ~ ~

sm block_display[block=iron_block, tag=wheel, tag=side_part, tag=upper_right_part, rotation=[-90, -45], tp_time=40] ~ ~ ~
sm block_display[block=iron_block, tag=wheel, tag=side_part, tag=lower_left_part, rotation=[-90, -45], tp_time=40] ~ ~ ~
sm block_display[block=iron_block, tag=wheel, tag=side_part, tag=upper_left_part, rotation=[-90, 45], tp_time=40] ~ ~ ~
sm block_display[block=iron_block, tag=wheel, tag=side_part, tag=lower_right_part, rotation=[-90, 45], tp_time=40] ~ ~ ~

// buckets
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=0, rotation=[-90, 0], tp_time=40] ~ ~ ~
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=1, rotation=[-90, 0], tp_time=40] ~ ~ ~
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=2, rotation=[-90, -45], tp_time=40] ~ ~ ~
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=3, rotation=[-90, 90], tp_time=40] ~ ~ ~
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=4, rotation=[-90, 90], tp_time=40] ~ ~ ~
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=5, rotation=[-90, 45], tp_time=40] ~ ~ ~
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=6, rotation=[-90, 0], tp_time=40] ~ ~ ~
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=7, rotation=[-90, 0], tp_time=40] ~ ~ ~
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=8, rotation=[-90, -45], tp_time=40] ~ ~ ~
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=9, rotation=[-90, 90], tp_time=40] ~ ~ ~
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=10, rotation=[-90, 90], tp_time=40] ~ ~ ~
sm block_display[block=cauldron, tag=wheel, tag=bucket, tag=11, rotation=[-90, 45], tp_time=40] ~ ~ ~

ex as @e[type=block_display, tag=center] run data modify @s transformation.scale set [4.0, 1.0, 1.0]
ex as @e[type=block_display, tag=rod] run data modify @s transformation.scale set [4.0, 1.0, 1.0]
ex as @e[type=block_display, tag=part] run data modify @s transformation.scale set [5.0, 1.0, 1.0]
ex as @e[type=block_display, tag=side_part] run data modify @s transformation.scale set [4.24264, 0.99, 1.0]

// rod rotation
data modify @e[type=block_display, tag=upper_rod, limit=1] transformation.left_rotation set [0.0, 0.0, 0.7071, 0.7071]
data modify @e[type=block_display, tag=lower_rod, limit=1] transformation.left_rotation set [0.0, 0.0, 0.7071, 0.7071]
data modify @e[type=block_display, tag=left_rod, limit=1] transformation.left_rotation set [0.0, 0.0, 0.7071, 0.7071]
data modify @e[type=block_display, tag=right_rod, limit=1] transformation.left_rotation set [0.0, 0.0, 0.7071, 0.7071]

// part rotation
data modify @e[type=block_display, tag=upper_part, limit=1] transformation.left_rotation set [0.0, 0.0, 0.7071, 0.7071]
data modify @e[type=block_display, tag=lower_part, limit=1] transformation.left_rotation set [0.0, 0.0, 0.7071, 0.7071]
data modify @e[type=block_display, tag=left_part, limit=1] transformation.left_rotation set [0.0, 0.0, 0.7071, 0.7071]
data modify @e[type=block_display, tag=right_part, limit=1] transformation.left_rotation set [0.0, 0.0, 0.7071, 0.7071]

// side part rotation
data modify @e[type=block_display, tag=upper_right_part, limit=1] transformation.left_rotation set [0.0, 0.0, 0.7071, 0.7071]
data modify @e[type=block_display, tag=lower_left_part, limit=1] transformation.left_rotation set [0.0, 0.0, 0.7071, 0.7071]
data modify @e[type=block_display, tag=upper_left_part, limit=1] transformation.left_rotation set [0.0, 0.0, 0.7071, 0.7071]
data modify @e[type=block_display, tag=lower_right_part, limit=1] transformation.left_rotation set [0.0, 0.0, 0.7071, 0.7071]

// bucket rotation
data modify @e[type=block_display, tag=bucket, tag=0, limit=1] transformation.left_rotation set [0.0, 0.0, 1.0, 0.0]
data modify @e[type=block_display, tag=bucket, tag=1, limit=1] transformation.left_rotation set [0.0, 0.0, 1.0, 0.0]

data modify @e[type=block_display, tag=bucket, tag=2, limit=1] transformation.left_rotation set [0.0, 0.0, 1.0, 0.0]

data modify @e[type=block_display, tag=bucket, tag=9, limit=1] transformation.left_rotation set [0.0, 0.0, 1.0, 0.0]
data modify @e[type=block_display, tag=bucket, tag=10, limit=1] transformation.left_rotation set [0.0, 0.0, 1.0, 0.0]

data modify @e[type=block_display, tag=bucket, tag=11, limit=1] transformation.left_rotation set [0.0, 0.0, 1.0, 0.0]

// [-0.5, -0.5, -0.5]
data modify @e[type=block_display, tag=center, limit=1] transformation.translation set [-3.5, -0.5, -0.5]

// rod position
data modify @e[type=block_display, tag=left_rod, limit=1] transformation.translation set [0.5, 0.5, -0.5]
data modify @e[type=block_display, tag=right_rod, limit=1] transformation.translation set [0.5, -4.5, -0.5]
data modify @e[type=block_display, tag=upper_rod, limit=1] transformation.translation set [0.5, 0.5, -0.5]
data modify @e[type=block_display, tag=lower_rod, limit=1] transformation.translation set [0.5, -4.5, -0.5]

// part position
data modify @e[type=block_display, tag=upper_part, limit=1] transformation.translation set [0.5, -2.5, 4.5]
data modify @e[type=block_display, tag=lower_part, limit=1] transformation.translation set [0.5, -2.5, -5.5]
data modify @e[type=block_display, tag=right_part, limit=1] transformation.translation set [0.5, -2.5, 4.5]
data modify @e[type=block_display, tag=left_part, limit=1] transformation.translation set [0.5, -2.5, -5.5]

// side part position
data modify @e[type=block_display, tag=upper_right_part, limit=1] transformation.translation set [0.495, -2.12132, 4.65685]
data modify @e[type=block_display, tag=lower_left_part, limit=1] transformation.translation set [0.495, -2.12132, -5.65685]
data modify @e[type=block_display, tag=upper_left_part, limit=1] transformation.translation set [0.495, -2.12132, -5.65685]
data modify @e[type=block_display, tag=lower_right_part, limit=1] transformation.translation set [0.495, -2.12132, 4.65685]

// bucket position
data modify @e[type=block_display, tag=bucket, tag=0, limit=1] transformation.translation set [0.5, -1.0, -6.5]
data modify @e[type=block_display, tag=bucket, tag=1, limit=1] transformation.translation set [0.5, 2.0, -6.5]

data modify @e[type=block_display, tag=bucket, tag=2, limit=1] transformation.translation set [0.5, 0.5, -6.65685]

data modify @e[type=block_display, tag=bucket, tag=3, limit=1] transformation.translation set [-0.5, -2.0, 5.5]
data modify @e[type=block_display, tag=bucket, tag=4, limit=1] transformation.translation set [-0.5, 1.0, 5.5]

data modify @e[type=block_display, tag=bucket, tag=5, limit=1] transformation.translation set [-0.5, -0.5, 5.65685]

data modify @e[type=block_display, tag=bucket, tag=6, limit=1] transformation.translation set [-0.5, -2.0, 5.5]
data modify @e[type=block_display, tag=bucket, tag=7, limit=1] transformation.translation set [-0.5, 1.0, 5.5]

data modify @e[type=block_display, tag=bucket, tag=8, limit=1] transformation.translation set [-0.5, -0.5, 5.65685]

data modify @e[type=block_display, tag=bucket, tag=9, limit=1] transformation.translation set [0.5, -1.0, -6.5]
data modify @e[type=block_display, tag=bucket, tag=10, limit=1] transformation.translation set [0.5, 2.0, -6.5]

data modify @e[type=block_display, tag=bucket, tag=11, limit=1] transformation.translation set [0.5, 0.5, -6.65685]
