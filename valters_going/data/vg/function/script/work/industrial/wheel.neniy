let shared = [tag=wheel, rotation=[-90, 90], tp_time=45]

// wheel
let center = [shared, block=netherite_block, scale=[4.0, 1.0, 1.0]]
let rod = [shared, block=iron_block, scale=[4.0, 1.0, 1.0]]
let part = [shared, block=iron_block, scale=[5.0, 1.0, 1.0]]
