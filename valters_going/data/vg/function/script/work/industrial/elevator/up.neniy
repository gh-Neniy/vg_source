ex at @e[tag=elevator] pos ~ ~1 ~ as @a[team=player, distance=..1] at @s run tp @s ~ ~0.1 ~
ex as @e[tag=elevator, type=!shulker] at @s run tp @s ~ ~0.1 ~
ex as @e[tag=elevator, tag=railing] at @s if block ~ ~ ~ chain run setblock ~ ~ ~ air replace
ex at @e[tag=elevator, tag=center] run pls minecart.riding @a ~ ~ ~ 0.03 0
