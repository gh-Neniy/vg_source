ex at @e[tag=small_elevator] pos ~ ~1 ~ as @a[team=player, distance=..1] at @s run tp @s ~ ~0.1 ~
ex as @e[tag=small_elevator, type=!shulker] at @s run tp @s ~ ~0.1 ~
ex as @e[tag=small_elevator, tag=railing] at @s if block ~ ~ ~ iron_chain run setblock ~ ~ ~ air replace
ex at @e[tag=small_elevator, tag=center] run pls entity.minecart.riding @a ~ ~ ~ 0.03 0
