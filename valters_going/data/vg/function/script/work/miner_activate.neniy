ex as @e[type=villager, tag=miner] at @s facing @p[team=player] run tp @s ~ ~ ~ ~ ~
data modify @e[type=villager, tag=miner, limit=1] name_visible set 1
data modify @e[type=villager, tag=miner, limit=1] silent set 0

ex unless ent @e[type=text_display, tag=work_info] pos -62.8 106 17.8 run fn script/work/info
