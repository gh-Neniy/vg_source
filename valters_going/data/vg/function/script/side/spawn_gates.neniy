let netherite_block_data = [tag=spawn_gates, block=netherite_block, scale=[1.0, 1.0, 0.5], tp_time=50]
let warped_planks_data = [tag=spawn_gates, block=warped_planks, tp_time=50]

// left door
let left_netherite = [netherite_block_data, tag=left_door, translation=[-0.5, 0.0, 2.5], rotation=[180.0, 0]]
let left_center = [warped_planks_data, tag=left_door, translation=[-0.5, 0.0, 1.5], rotation=[180.0, 0]]
let left_corner = [warped_planks_data, tag=left_door, translation=[-0.5, 0.0, 0.5], rotation=[180.0, 0]]

sm block_display[left_netherite] ~ ~ ~3
sm block_display[left_netherite] ~ ~1 ~3
sm block_display[left_netherite] ~ ~2 ~3
sm block_display[left_netherite] ~ ~3 ~3
sm block_display[left_netherite] ~ ~4 ~3
sm block_display[left_center] ~ ~ ~3
sm block_display[left_center] ~ ~1 ~3
sm block_display[left_center] ~ ~2 ~3
sm block_display[left_center] ~ ~3 ~3
sm block_display[left_center] ~ ~4 ~3
sm block_display[left_corner] ~ ~ ~3
sm block_display[left_corner] ~ ~1 ~3
sm block_display[left_corner] ~ ~2 ~3
sm block_display[left_corner] ~ ~3 ~3
sm block_display[left_corner] ~ ~4 ~3

// right door
let right_netherite = [netherite_block_data, tag=right_door, translation=[-0.5, 0.0, 2.5]]
let right_center = [warped_planks_data, tag=right_door, translation=[-0.5, 0.0, 1.5]]
let right_corner = [warped_planks_data, tag=right_door, translation=[-0.5, 0.0, 0.5]]

sm block_display[right_netherite] ~ ~ ~-3
sm block_display[right_netherite] ~ ~1 ~-3
sm block_display[right_netherite] ~ ~2 ~-3
sm block_display[right_netherite] ~ ~3 ~-3
sm block_display[right_netherite] ~ ~4 ~-3
sm block_display[right_center] ~ ~ ~-3
sm block_display[right_center] ~ ~1 ~-3
sm block_display[right_center] ~ ~2 ~-3
sm block_display[right_center] ~ ~3 ~-3
sm block_display[right_center] ~ ~4 ~-3
sm block_display[right_corner] ~ ~ ~-3
sm block_display[right_corner] ~ ~1 ~-3
sm block_display[right_corner] ~ ~2 ~-3
sm block_display[right_corner] ~ ~3 ~-3
sm block_display[right_corner] ~ ~4 ~-3

// pivots
sm block_display[tag=spawn_gates, tag=left_pivot, rotation=[180.0, 0.0]] ~ ~ ~3
sm block_display[tag=spawn_gates, tag=right_pivot] ~ ~ ~-3

// collisions

let collision = [
    tag=spawn_gates
    passenger=shulker[
        no_ai, silent, invulnerable, effect=invisibility, scale=0.25, tag=spawn_gates
    ],
]

let left_collision = [collision, tag=left_door]
let right_collision = [collision, tag=right_door]

// lower left

ex at @e[tag=spawn_gates, tag=left_pivot] run sm block_display[left_collision, tag=0] ^0.375 ^0.5 ^0.625
