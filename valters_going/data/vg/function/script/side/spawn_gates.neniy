ex as @e[type=block_display, tag=spawn_gates, tag=left_door, tag=0]
    run data modify @s scale set [1.0, 1.0, 0.5]
ex as @e[type=block_display, tag=spawn_gates, tag=right_door, tag=0]
    run data modify @s scale set [1.0, 1.0, 0.5]

ex as @e[type=block_display, tag=spawn_gates, tag=left_door, tag=0]
    run data modify @s translation set [-0.5, 0.0, -3.0]
ex as @e[type=block_display, tag=spawn_gates, tag=left_door, tag=1]
    run data modify @s translation set [-0.5, 0.0, -2.5]
ex as @e[type=block_display, tag=spawn_gates, tag=left_door, tag=2]
    run data modify @s translation set [-0.5, 0.0, -1.5]

ex as @e[type=block_display, tag=spawn_gates, tag=right_door, tag=0]
    run data modify @s translation set [-0.5, 0.0, 2.5]
ex as @e[type=block_display, tag=spawn_gates, tag=right_door, tag=1]
    run data modify @s translation set [-0.5, 0.0, 1.5]
ex as @e[type=block_display, tag=spawn_gates, tag=right_door, tag=2]
    run data modify @s translation set [-0.5, 0.0, 0.5]

ex as @e[type=block_display, tag=spawn_gates, tag=left_door] at @s run tp @s ~ ~ ~ ~-45 ~
ex as @e[type=block_display, tag=spawn_gates, tag=right_door] at @s run tp @s ~ ~ ~ ~45 ~

pls shroomlight.step @a ~ ~ ~ 3 0
pls cave @a ~ ~ ~ 3 1
ptc campfire_cosy_smoke ~0.5 ~2 ~ 0 2 0 0.005 35 force
