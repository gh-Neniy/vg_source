scb players add #health data 1

fn script/side/shop
clear @s iron_nugget 10

setblock oak_wall_sign[facing=east, sign=[ 
  {text='Здоровье', color=blue}
  {text='Цена:'}
  {text='15 Серебряных', color=gray}
  {text='копеек', color=gray}
]] ~ ~1 ~ replace

tellraw @a [
  {text='Количество вашего здоровья повышено на ', color=green}
  {text='2 сердца', color=blue}
]
