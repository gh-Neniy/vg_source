scb players add #health data 1

fn script/side/shop
clear @s iron_nugget 25

setblock ~ ~1 ~ oak_wall_sign[facing=east, sign=[ 
  {text='Здоровье', color=blue}
  {text='Цена:'}
  {text='30 Серебряных', color=gray}
  {text='копеек', color=gray}
]] replace

tellraw @a [
  {text='Количество вашего здоровья повышено ещё на ', color=green}
  {text='2 сердца', color=blue}
]
