use vg

scb players add #attack_damage data 1

fn script/side/shop
clear @s iron_nugget 10

setblock oak_wall_sign[facing=east, sign=[ 
  {text='Урон от атаки', color=blue}
  {text='Цена:'}
  {text='20 Серебряных', color=gray}
  {text='копеек', color=gray}
]] ~ ~1 ~ replace

tellraw @a [
  {text='Урон от ваших атак повышен на ', color=green}
  {text='1 единицу', color=blue}
]
