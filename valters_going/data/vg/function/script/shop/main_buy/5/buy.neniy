fn script/side/shop
scb players add #shop data 1

clear @s iron_nugget 10
clear @a[team=player] wooden_sword

ex as @a[team=player] run fn item/shop/rusty_sword

setblock ~ ~1 ~ oak_wall_sign[facing=east, sign=[ 
  {text='Улучшение меча', color=blue}
  {text='Цена:'}
  {text='9 Серебряных', color=gray}
  {text='копеек', color=gray}
]] replace
