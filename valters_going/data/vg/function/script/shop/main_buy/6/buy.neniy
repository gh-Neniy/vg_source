fn script/side/shop
scb players add #shop data 1

clear @s iron_nugget 9
clear @a[team=player] stone_sword

ex as @a[team=player] run fn item/shop/rusty_sword_2

setblock ~ ~1 ~ oak_wall_sign[facing=east, sign=[ 
  {text='Улучшение меча', color=blue}
  {text='Цена:'}
  {text='10 Серебряных', color=gray}
  {text='копеек', color=gray}
]] replace

tellraw @a [
  {text='Улучшение меча ', color=green}
  {text='Добыча 2', color=blue}
  {text=' получено', color=green}
]
