fn script/side/shop
scb players add #shop data 1

clear @s iron_nugget 14
clear @a[team=player] bow

ex as @a[team=player] run fn item/shop/bow_2

setblock oak_wall_sign[facing=east, sign=[ 
  {text='Ржавый меч', color=gray}
  {text='Цена:'}
  {text='10 Серебряных', color=gray}
  {text='копеек', color=gray}
]] ~ ~1 ~ replace

tellraw @a [
  {text='Улучшение лука ', color=green}
  {text='Сила', color=blue}
  {text=' получено', color=green}
]
