fn script/side/shop
scb players add #shop data 1

clear @s iron_nugget 5
clear @a[team=player] wooden_sword

ex as @a[team=player] run fn item/shop/training_sword_3

setblock ~ ~1 ~ oak_wall_sign[facing=east, sign=[ 
  {text='Лук', color=gray}
  {text='Цена:'}
  {text='10 Серебряных', color=gray}
  {text='копеек', color=gray}
]] replace

tellraw @a [
  {text='Улучшение меча ', color=green}
  {text='Отдача', color=blue}
  {text=' получено', color=green}
]
