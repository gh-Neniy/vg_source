use vg

fn script/side/shop
scb players add #shop data 1

clear @s iron_nugget 10

ex as @a[team=player] run fn item/shop/bow
ex as @a[team=player] run fn item/shop/arrow

setblock oak_wall_sign[facing=east, sign=[ 
  {text='Улучшение лука', color=blue}
  {text='Цена:'}
  {text='14 Серебряных', color=gray}
  {text='копеек', color=gray}
]] ~ ~1 ~ replace

scb players set #preview data 1
