use vg

fn script/side/shop
scb players add #shop data 1

clear @s iron_nugget 30
clear @a[team=player] blaze_rod

ex as @a[team=player] run fn item/shop/fire_staff_2

setblock oak_wall_sign[facing=east, sign=[ 
  {text='Арбалет', color=dark_aqua}
  {text='Цена:'}
  {text='60 Серебряных', color=gray}
  {text='копеек', color=gray}
]] ~ ~1 ~ replace

tellraw @a [
  {text='Жезл улучшен: ', color=green}
  {text='Вместимость и урон', color=blue}
  {text=' повышены', color=green}
]
