use vg

ex if block ~ ~ ~ crimson_button[powered] if score #health data 0 run fn script/shop/health/0
ex if block ~ ~ ~ crimson_button[powered] if score #health data 1 run fn script/shop/health/1
ex if block ~ ~ ~ crimson_button[powered] if score #health data 2 run fn script/shop/health/2
ex if block ~ ~ ~ crimson_button[powered] if score #health data 3 run fn script/shop/health/3
ex if block ~ ~ ~ crimson_button[powered] if score #health data 4 run fn script/shop/health/4
