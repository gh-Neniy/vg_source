ex if score #timer data 0 run scb players set #timer_active data 1
ex if score #timer data 30 run fn script/beginning/preview/0

ex if score #timer data 50 run fn script/beginning/letter/capital_v
ex if score #timer data 55 run fn script/beginning/letter/a
ex if score #timer data 60 run fn script/beginning/letter/l
ex if score #timer data 65 run fn script/beginning/letter/t
ex if score #timer data 70 run fn script/beginning/letter/e
ex if score #timer data 75 run fn script/beginning/letter/r
ex if score #timer data 80 run fn script/beginning/letter/s
ex if score #timer data 85 run fn script/beginning/letter/capital_g
ex if score #timer data 90 run fn script/beginning/letter/o
ex if score #timer data 95 run fn script/beginning/letter/i
ex if score #timer data 100 run fn script/beginning/letter/n
ex if score #timer data 105 run fn script/beginning/letter/g

ex if score #timer data 180 run fn script/beginning/preview/1
