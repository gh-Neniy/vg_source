fill -100 110 -31 -96 114 -27 air destroy

title @a title {}
title @a subtitle {text='Огненный босс', color=red}
pls cave @a -98 110 -29 10 0.7

ex pos -98 110 -29 run fn mob/boss/magma_cube

bossbar add boss_magma_cube {text='Огненный босс', color=yellow}
bossbar set boss_magma_cube players @a
bossbar set boss_magma_cube color red
bossbar set boss_magma_cube max 130
