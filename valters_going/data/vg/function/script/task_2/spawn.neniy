pls entity.blaze.shoot @a ~ ~2 ~ 10 1

setblock spruce_wall_sign[facing=south, sign=[
  {text='Задание'}
  {text='Огненный босс', color=red}
  {}
  {text='Начать'}
]] ~ ~2 ~1 replace
