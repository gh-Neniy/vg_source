use vg

ex if score #timer data 0 run fn script/task_2/run/0
ex if score #timer data 60 run fn script/task_2/run/1

ex if score #timer data 100 pos -109 116 -26 run fn mob/phantom
ex if score #timer data 150 pos -100 116 -29 run fn mob/phantom
ex if score #timer data 200 pos -80 116 -26 run fn mob/phantom
ex if score #timer data 250 pos -99 114 -30 run fn mob/phantom
ex if score #timer data 300 pos -100 116 -24 run fn mob/phantom
ex if score #timer data 350 pos -79 116 -26 run fn mob/phantom
ex if score #timer data 400 pos -109 116 -26 run fn mob/phantom
ex if score #timer data 450 pos -89 119 -24 run fn mob/phantom
ex if score #timer data 500 pos -99 116 -30 run fn mob/phantom
ex if score #timer data 550 pos -109 116 -26 run fn mob/phantom
ex if score #timer data 600 pos -79 114 -26 run fn mob/phantom
ex if score #timer data 650 pos -79 116 -26 run fn mob/phantom
ex if score #timer data 700 pos -109 116 -26 run fn mob/phantom

ex if score #timer data 700 run fn script/task_2/run/2
ex if score #timer data 701 unless ent @e[tag=enemy] run scb players set #boss_timer_active data 1

ex if score #boss_timer data 50 run fn script/task_2/run/3
ex if score #boss_timer data 100 run fn script/task_2/run/4
ex if score #boss_timer data 150 run fn script/task_2/run/5

ex if score #boss_timer data 141..281 store bossbar boss_magma_cube run data get @e[tag=boss_magma_cube, limit=1] Health
ex if score #boss_timer data 281 run fn script/task_2/servant

// ex if score #timer data 701 unless ent @e[tag=boss_magma_cube] run 
ex if score #timer data 702 unless ent @e[tag=enemy] run fn script/task_2/run/6
ex if score #timer data 750 run fn script/task_2/run/7

ex as @a[team=player, score=[defeat=1]] run fn script/task_2/defeat
