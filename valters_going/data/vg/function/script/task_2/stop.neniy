use vg

fn script/task_2/remove_decor
fill -94 105 4 -94 106 4 air replace
fill -101 105 15 -97 109 15 iron_bars keep // gates
gamerule natural_regeneration true
bossbar remove boss_magma_cube
scb players set #task_2_run data 2
fn script/stop_timer
fn script/stop_boss_timer

ex as @e[tag=enemy] run fn script/delete_mob
