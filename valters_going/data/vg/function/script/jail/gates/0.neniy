fn vg:script/start_timer
fill ~ ~ ~ ~ ~4 ~5 air replace nether_brick_fence

sm block_display ~ ~ ~ {tag:[jail_gates, 0], id=nether_brick_fence[north, south], teleport_duration: 40}
sm block_display ~ ~ ~1 {tag:[jail_gates, 0], id=nether_brick_fence[north, south], teleport_duration: 40}
sm block_display ~ ~ ~2 {tag:[jail_gates, 0], id=nether_brick_fence[north, south], teleport_duration: 40}
sm block_display ~ ~ ~3 {tag:[jail_gates, 0], id=nether_brick_fence[north, south], teleport_duration: 40}
sm block_display ~ ~ ~4 {tag:[jail_gates, 0], id=nether_brick_fence[north, south], teleport_duration: 40}
sm block_display ~ ~ ~5 {tag:[jail_gates, 0], id=nether_brick_fence[north, south], teleport_duration: 40}

sm block_display ~ ~1 ~ {tag:[jail_gates, 1], id=nether_brick_fence[north, south], teleport_duration: 40}
sm block_display ~ ~1 ~1 {tag:[jail_gates, 1], id=nether_brick_fence[north, south], teleport_duration: 40}
sm block_display ~ ~1 ~2 {tag:[jail_gates, 1], id=nether_brick_fence[north, south], teleport_duration: 40}
sm block_display ~ ~1 ~3 {tag:[jail_gates, 1], id=nether_brick_fence[north, south], teleport_duration: 40}
sm block_display ~ ~1 ~4 {tag:[jail_gates, 1], id=nether_brick_fence[north, south], teleport_duration: 40}
sm block_display ~ ~1 ~5 {tag:[jail_gates, 1], id=nether_brick_fence[north, south], teleport_duration: 40}

sm block_display ~ ~2 ~ {tag:[jail_gates, 2], id=nether_brick_fence[north, south], teleport_duration: 40}
sm block_display ~ ~2 ~1 {tag:[jail_gates, 2], id=nether_brick_fence[north, south], teleport_duration: 40}
sm block_display ~ ~2 ~2 {tag:[jail_gates, 2], id=nether_brick_fence[north, south], teleport_duration: 40}
sm block_display ~ ~2 ~3 {tag:[jail_gates, 2], id=nether_brick_fence[north, south], teleport_duration: 40}
sm block_display ~ ~2 ~4 {tag:[jail_gates, 2], id=nether_brick_fence[north, south], teleport_duration: 40}
sm block_display ~ ~2 ~5 {tag:[jail_gates, 2], id=nether_brick_fence[north, south], teleport_duration: 40}

sm block_display ~ ~3 ~1 {tag:[jail_gates, 3], id=nether_brick_fence[north, south], teleport_duration: 40}
sm block_display ~ ~3 ~2 {tag:[jail_gates, 3], id=nether_brick_fence[north, south], teleport_duration: 40}
sm block_display ~ ~3 ~3 {tag:[jail_gates, 3], id=nether_brick_fence[north, south], teleport_duration: 40}
sm block_display ~ ~3 ~4 {tag:[jail_gates, 3], id=nether_brick_fence[north, south], teleport_duration: 40}

ex as @e[tag=jail_gates] at @s run tp @s ~ ~1 ~
