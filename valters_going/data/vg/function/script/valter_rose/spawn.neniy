sm block_display[id=potted_wither_rose, tag=valter_rose, teleport_duration=5, rotation=[90, 0]] ~ ~ ~
sm interaction[tag=valter_rose, height=0.8, width=0.4] ~ ~ ~

native 'execute as @e[type=block_display, tag=valter_rose, limit=1, sort=nearest] run data modify entity @s transformation.translation set value [-0.5f, 0.0f, -0.5f]'
