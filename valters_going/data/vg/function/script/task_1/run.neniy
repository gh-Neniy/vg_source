ex if score #timer data 0 run fn script/task_1/run/0
ex if score #timer data 60 run fn script/task_1/run/1
ex if score #timer data 120 run fn script/task_1/run/random_pos
ex if score #timer data 240 run fn script/task_1/run/random_pos
ex if score #timer data 360 run fn script/task_1/run/random_pos
ex if score #timer data 480 run fn script/task_1/run/2
ex if score #timer data 481 unless ent @e[tag=enemy] run scb players set #timer_active data 1
ex if score #timer data 520 run fn script/task_1/run/3
ex if score #timer data 580 run fn script/task_1/run/4
ex if score #timer data 640 run fn script/task_1/run/5

ex if score #timer data 580..641 store bossbar boss_skeleton run data get @e[tag=boss_skeleton, limit=1] health

ex if score #boss_timer data 200 run fn script/task_1/run/6
ex if score #boss_timer data 400 at @e[tag=boss_skeleton] run fn script/task_1/run/random_mob
ex if score #boss_timer data 600 at @e[tag=boss_skeleton] run fn script/task_1/run/random_mob
ex if score #boss_timer data 800 at @e[tag=boss_skeleton] run fn script/task_1/run/random_mob
ex if score #boss_timer data 1000 at @e[tag=boss_skeleton] run fn script/task_1/run/essence_respawn

ex if score #timer data 641 unless ent @e[tag=boss_skeleton] run bossbar remove boss_skeleton
ex if score #timer data 641 unless ent @e[tag=enemy] run fn script/task_1/run/7
ex if score #timer data 700 run fn script/task_1/run/8

ex as @a[team=player, score=[defeat=1]] run fn script/task_1/defeat
