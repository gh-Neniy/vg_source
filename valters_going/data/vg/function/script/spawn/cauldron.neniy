ex if score #timer data 0 run fn script/spawn/cauldron/0
ex if score #timer data 30 run fn script/spawn/cauldron/pop
ex if score #timer data 55 run fn script/spawn/cauldron/pop
ex if score #timer data 75 run fn script/spawn/cauldron/pop
ex if score #timer data 90 run fn script/spawn/cauldron/pop
ex if score #timer data 100 run fn script/spawn/cauldron/pop
ex if score #timer data 120 run fn script/spawn/cauldron/1

ex if score #timer data 121 pos 16.0 94.0 -31.0
  unless ent @e[data=[item=trident[tag=trident]],dx=0,dy=1,dz=0] run scb players set #timer_active data 1
  
ex if score #timer data 160 run fn script/spawn/cauldron/2
