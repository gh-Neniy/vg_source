gamerule keep_inventory true
gamerule natural_regeneration true

team add player
team join player @a[tag=!admin]
team modify player friendly_fire false
team modify player collision never
gm adventure @a[team=player]
ex as @a[team=player] run fn script/spawn/set_id
ex as @p[team=player] run fn item/flint_and_steel
kill @e[tag=flint_and_steel]

scb players set #progress data 2
scb players set #candle data 0

tellraw @a [
    {text='Добро пожаловать на карту Valter\'s Going!\n', color=gray},
    {text='Зеленым текстом', color=green},
    {text=' пишутся основные оповещения, ', color=gray},
    {text='красным текстом', color=dark_red},
    {text=' пишется текущее задание.' color=gray}
]
tellraw @a {text='Совершите ритуал по призыву Вальтера. Для этого в замке зажгите 12 свечей вокруг Несокрушимого Блока.', color=dark_red}
time set night

ptc campfire_cosy_smoke ~ ~0.1 ~ 0.3 0.025 0.3 0.01 5 normal
pls axe.wax_off @a ~ ~0.1 ~ 1 2
