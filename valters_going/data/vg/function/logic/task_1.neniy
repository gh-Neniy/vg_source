ex at @e[type=text_display, tag=task_1, tag=name] pos ~ ~-2.5 ~ as @a[team=player, distance=..1] run fn script/task_1/tp

ex pos -61 101 -18 if block ~ ~ ~ oak_button[powered] as @p[team=player] run fn script/task_1/return
ex pos -61 101 -14 if block ~ ~ ~ oak_button[powered] as @p[team=player] run fn script/task_1/start_button
