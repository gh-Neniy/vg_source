ex unless score #spawn_gates data 2 pos 32 100 -8 if ent @a[team=player, dx=2, dy=3, dz=4] run scb players set #spawn_gates data 1
ex if score #spawn_gates data 1 run fn script/spawn/gates

ex pos 12 103 -5 if block ~ ~ ~ candle[lit] run fn script/spawn/candle
ex pos 11 103 -4 if block ~ ~ ~ candle[lit] run fn script/spawn/candle
ex pos 10 103 -3 if block ~ ~ ~ candle[lit] run fn script/spawn/candle
ex pos 8 103 -3 if block ~ ~ ~ candle[lit] run fn script/spawn/candle
ex pos 7 103 -4 if block ~ ~ ~ candle[lit] run fn script/spawn/candle
ex pos 6 103 -5 if block ~ ~ ~ candle[lit] run fn script/spawn/candle
ex pos 6 103 -7 if block ~ ~ ~ candle[lit] run fn script/spawn/candle
ex pos 7 103 -8 if block ~ ~ ~ candle[lit] run fn script/spawn/candle
ex pos 8 103 -9 if block ~ ~ ~ candle[lit] run fn script/spawn/candle
ex pos 10 103 -9 if block ~ ~ ~ candle[lit] run fn script/spawn/candle
ex pos 11 103 -8 if block ~ ~ ~ candle[lit] run fn script/spawn/candle
ex pos 12 103 -7 if block ~ ~ ~ candle[lit] run fn script/spawn/candle

ex if score #candle data 12 run scb players set #invocation data 1

fill 6 103 -9 12 103 -3 air replace fire
