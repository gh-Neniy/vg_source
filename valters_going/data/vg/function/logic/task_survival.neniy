ex pos -59 81 -18 if block ~ ~ ~ spruce_button[powered] as @p[team=player] run fn script/return_to_arena
ex pos -59 81 -14 if block ~ ~ ~ spruce_button[powered] as @p[team=player] run scb players set #task_survival_run data 1
