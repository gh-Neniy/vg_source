ex at @e[type=text_display, tag=task_2, tag=name] pos ~ ~-2.5 ~ as @a[team=player, distance=..1] run fn script/task_2/tp

ex pos -52 101 -18 if block ~ ~ ~ spruce_button[powered] as @p[team=player] run fn script/task_2/return
ex pos -52 101 -14 if block ~ ~ ~ spruce_button[powered] run fn script/task_2/start_button
