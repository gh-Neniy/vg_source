use vg

ex if score #progress data 0..1 run fn logic/spawn
ex if score #progress data 0 run fn logic/progress/0 // on the very beginning
ex if score #progress data 1 run fn logic/progress/1 // before start button

ex if score #progress data 3.. run fn logic/arena
ex if score #progress data 2 run fn logic/progress/2 // before invocation
ex if score #progress data 3 run fn logic/progress/3 // before task 0
ex if score #progress data 4 run fn logic/progress/4 // before task 1
