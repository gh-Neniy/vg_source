ex at @e[type=text_display, tag=speed_essence] run ptc cloud ~ ~-1 ~ 0.2 0.5 0.2 0.02 1 normal
ex as @e[type=text_display, tag=speed_essence] at @s pos ~ ~-2 ~ if ent @a[team=player, distance=..1, tag=!speed_essence] run fn script/essence/speed

ex at @a[team=player, tag=speed_essence] run ptc cloud ~ ~0.3 ~ 0.2 0.2 0.2 0.01 1 normal

ex at @a[team=player, tag=speed_essence] as @e[tag=enemy, distance=..2, data=[hurt_time=10]] at @s run fn script/essence/speed/hit
ex at @a[team=player, tag=speed_essence] pos ^ ^ ^1.5 as @e[tag=enemy, distance=..2, data=[hurt_time=10]] at @s run fn script/essence/speed/hit
ex at @a[team=player, tag=speed_essence] pos ^ ^ ^3 as @e[tag=enemy, distance=..2, data=[hurt_time=10]] at @s run fn script/essence/speed/hit
