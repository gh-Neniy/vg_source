ex at @e[type=text_display, tag=ice_essence] run ptc falling_water ~ ~ ~ 0.2 0.5 0.2 0.05 1 normal
ex at @e[type=text_display, tag=ice_essence] run ptc end_rod ~ ~-1 ~ 0.2 0.5 0.2 0.01 1 normal
ex as @e[type=text_display, tag=ice_essence] at @s pos ~ ~-2 ~ if ent @a[team=player, distance=..1, tag=!ice_essence] run fn script/essence/ice

ex at @a[team=player, tag=ice_essence] run ptc falling_water ~ ~1 ~ 0.2 0.2 0.2 0.01 1 normal
ex at @a[team=player, tag=ice_essence] run ptc end_rod ~ ~0.3 ~ 0.2 0.2 0.2 0.01 1 normal

ex at @a[team=player, tag=ice_essence] as @e[tag=enemy, distance=..2, data=[hurt_time=10]] at @s run fn script/essence/ice/hit
ex at @a[team=player, tag=ice_essence] pos ^ ^ ^1.5 as @e[tag=enemy, distance=..2, data=[hurt_time=10]] at @s run fn script/essence/ice/hit
ex at @a[team=player, tag=ice_essence] pos ^ ^ ^3 as @e[tag=enemy, distance=..2, data=[hurt_time=10]] at @s run fn script/essence/ice/hit
