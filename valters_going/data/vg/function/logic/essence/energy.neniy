ex at @e[type=text_display, tag=essence, tag=energy] run ptc electric_spark ~ ~-1 ~ 0.2 0.5 0.2 0.05 3 normal
ex as @e[type=text_display, tag=essence, tag=energy] at @s pos ~ ~-2 ~ if ent @a[team=player, distance=..1, tag=!energy] run fn script/essence/energy

ex at @a[team=player, tag=energy] run ptc electric_spark ~ ~0.3 ~ 0.2 0.2 0.2 0.01 1 normal

ex at @a[team=player, tag=energy] as @e[tag=enemy, distance=..2, data=[hurt_time=10]] at @s run fn script/essence/energy/hit
ex at @a[team=player, tag=energy] pos ^ ^ ^1.5 as @e[tag=enemy, distance=..2, data=[hurt_time=10]] at @s run fn script/essence/energy/hit
ex at @a[team=player, tag=energy] pos ^ ^ ^3 as @e[tag=enemy, distance=..2, data=[hurt_time=10]] at @s run fn script/essence/energy/hit
