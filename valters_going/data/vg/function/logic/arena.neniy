use vg

fn logic/shop

ex as @a[team=player] store score @s money run clear @s iron_nugget 0

ex pos -57 106 4 if ent @a[team=player, distance=..8] run fn script/side/shop_tp
ex pos -110 87 -38 if ent @a[team=player, distance=..8] run fn script/side/shop_tp

ex pos -57 105 4 as @a[team=player, y_rotation=-130..-50, dx=0, dy=1, dz=0] pos -110 86 -38 run fn script/shop/tp
ex pos -110 86 -38 as @a[team=player, y_rotation=-130..-50, dx=0, dy=1, dz=0] pos -57 105 4 run fn script/shop/tp

ex pos -101 105 16 as @a[team=player, dx=4, dy=1, dz=0] at @s run tp @s ~ ~ ~-1

// for buttons on the arena (partially available on different stages)
ex if score #task_1 data 1 run fn logic/task_1
ex if score #task_2 data 1 run fn logic/task_2
ex if score #task_3 data 1 run fn logic/task_3
ex if score #task_4 data 1 run fn logic/task_4
ex if score #task_5 data 1 run fn logic/task_5
ex if score #task_survival data 1 run fn logic/task_survival
