ex as @a[team=player,tag=!cutscene,gm=!adventure] at @s run fn vg:script/valter_regulation
ex as @a[team=player,tag=cutscene,gm=!spectator] run gm spectator @s
ex as @a[team=player,tag=cutscene] run spectate @e[type=block_display, tag=cutscene, limit=1]

effect give @a[tag=night_vision] night_vision infinite 0

kill @e[type=experience_orb]

ex if score #timer_active data 1 run scb players add #timer data 1
ex if score #boss_timer_active data 1 run scb players add #boss_timer data 1
