use vg

fn logic/run

ex as @a[team=player,tag=!cutscene,gm=!adventure] at @s run fn script/valter_regulation
ex as @a[team=player,tag=cutscene,gm=!spectator] run gm spectator @s
ex as @a[team=player,tag=cutscene] run spectate @e[type=block_display, tag=cutscene, tag=!decor, limit=1]

effect give @a[tag=night_vision] night_vision infinite 0

kill @e[type=experience_orb]

ex as @e[tag=boss_magma_cube] unless ent @s[data=[size=5]] run fn script/delete_mob
ex as @e[tag=servant] unless ent @s[data=[size=2]] run fn script/delete_mob

ex if score #timer_active data 1 run scb players add #timer data 1
ex if score #boss_timer_active data 1 run scb players add #boss_timer data 1
