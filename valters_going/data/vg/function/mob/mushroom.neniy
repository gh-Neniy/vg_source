sm zombie[
  health=45.0,
  loot_table=vg:mushroom,
  no_despawn,
  silent,
  tag=enemy,
  tag=mushroom
] ~ ~ ~

sm block_display[id=mushroom_stem, tag=mushroom, tag=stem, teleport_duration=2] ~ ~ ~
ex as @e[tag=mushroom, tag=stem, sort=nearest, limit=1] run data modify @s transformation.translation set [-0.2, 0.0, -0.2]
ex as @e[tag=mushroom, tag=stem, sort=nearest, limit=1] run data modify @s transformation.scale set [0.4, 1.6, 0.4]

sm block_display[id=brown_mushroom_block, tag=mushroom, tag=hat, teleport_duration=2] ~ ~ ~
ex as @e[tag=mushroom, tag=hat, sort=nearest, limit=1] run data modify @s transformation.translation set [-0.6, 1.6, -0.6]
ex as @e[tag=mushroom, tag=hat, sort=nearest, limit=1] run data modify @s transformation.scale set [1.2, 0.4, 1.2]

sm block_display[id=brown_mushroom_block, tag=mushroom, tag=hat_border1, teleport_duration=2] ~ ~ ~
ex as @e[tag=mushroom, tag=hat_border1, sort=nearest, limit=1] run data modify @s transformation.translation set [0.6, 1.6, -0.6]
ex as @e[tag=mushroom, tag=hat_border1, sort=nearest, limit=1] run data modify @s transformation.scale set [0.4, 0.4, 1.2]

sm block_display[id=brown_mushroom_block, tag=mushroom, tag=hat_border2, teleport_duration=2] ~ ~ ~
ex as @e[tag=mushroom, tag=hat_border2, sort=nearest, limit=1] run data modify @s transformation.translation set [-1.0, 1.6, -0.6]
ex as @e[tag=mushroom, tag=hat_border2, sort=nearest, limit=1] run data modify @s transformation.scale set [0.4, 0.4, 1.2]

sm block_display[id=brown_mushroom_block, tag=mushroom, tag=hat_border3, teleport_duration=2] ~ ~ ~
ex as @e[tag=mushroom, tag=hat_border3, sort=nearest, limit=1] run data modify @s transformation.translation set [-0.6, 1.6, 0.6]
ex as @e[tag=mushroom, tag=hat_border3, sort=nearest, limit=1] run data modify @s transformation.scale set [1.2, 0.4, 0.4]

sm block_display[id=brown_mushroom_block, tag=mushroom, tag=hat_border4, teleport_duration=2] ~ ~ ~
ex as @e[tag=mushroom, tag=hat_border4, sort=nearest, limit=1] run data modify @s transformation.translation set [-0.6, 1.6, -1.0]
ex as @e[tag=mushroom, tag=hat_border4, sort=nearest, limit=1] run data modify @s transformation.scale set [1.2, 0.4, 0.4]

sm text_display[tag=mushroom, tag=text, text={text='Живой Гриб', color=red}, teleport_duration=2] ~ ~ ~
ex as @e[tag=mushroom, tag=text, sort=nearest, limit=1] run data modify @s transformation.translation set [0.0, 2.4, 0.0]
ex as @e[tag=mushroom, tag=text, sort=nearest, limit=1] run data modify @s transformation.scale set [1.5, 1.5, 1.5]
