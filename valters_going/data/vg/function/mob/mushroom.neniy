sm zombie[
  health=45.0,
  loot_table=vg:mushroom,
  no_despawn,
  silent,
  tag=enemy,
  tag=mushroom
] ~ ~ ~

sm block_display[block=mushroom_stem, tag=mushroom, tag=stem, tp_time=2] ~ ~ ~
ex as @e[tag=mushroom, tag=stem, sort=nearest, limit=1] run data modify @s translation set [-0.2, 0.0, -0.2]
ex as @e[tag=mushroom, tag=stem, sort=nearest, limit=1] run data modify @s scale set [0.4, 1.6, 0.4]

sm block_display[block=brown_mushroom_block, tag=mushroom, tag=hat, tp_time=2] ~ ~ ~
ex as @e[tag=mushroom, tag=hat, sort=nearest, limit=1] run data modify @s translation set [-0.6, 1.6, -0.6]
ex as @e[tag=mushroom, tag=hat, sort=nearest, limit=1] run data modify @s scale set [1.2, 0.4, 1.2]

sm block_display[block=brown_mushroom_block, tag=mushroom, tag=hat_border1, tp_time=2] ~ ~ ~
ex as @e[tag=mushroom, tag=hat_border1, sort=nearest, limit=1] run data modify @s translation set [0.6, 1.6, -0.6]
ex as @e[tag=mushroom, tag=hat_border1, sort=nearest, limit=1] run data modify @s scale set [0.4, 0.4, 1.2]

sm block_display[block=brown_mushroom_block, tag=mushroom, tag=hat_border2, tp_time=2] ~ ~ ~
ex as @e[tag=mushroom, tag=hat_border2, sort=nearest, limit=1] run data modify @s translation set [-1.0, 1.6, -0.6]
ex as @e[tag=mushroom, tag=hat_border2, sort=nearest, limit=1] run data modify @s scale set [0.4, 0.4, 1.2]

sm block_display[block=brown_mushroom_block, tag=mushroom, tag=hat_border3, tp_time=2] ~ ~ ~
ex as @e[tag=mushroom, tag=hat_border3, sort=nearest, limit=1] run data modify @s translation set [-0.6, 1.6, 0.6]
ex as @e[tag=mushroom, tag=hat_border3, sort=nearest, limit=1] run data modify @s scale set [1.2, 0.4, 0.4]

sm block_display[block=brown_mushroom_block, tag=mushroom, tag=hat_border4, tp_time=2] ~ ~ ~
ex as @e[tag=mushroom, tag=hat_border4, sort=nearest, limit=1] run data modify @s translation set [-0.6, 1.6, -1.0]
ex as @e[tag=mushroom, tag=hat_border4, sort=nearest, limit=1] run data modify @s scale set [1.2, 0.4, 0.4]

sm text_display[tag=mushroom, tag=text, text={text='Живой Гриб', color=red}, tp_time=2] ~ ~ ~
ex as @e[tag=mushroom, tag=text, sort=nearest, limit=1] run data modify @s translation set [0.0, 2.4, 0.0]
ex as @e[tag=mushroom, tag=text, sort=nearest, limit=1] run data modify @s scale set [1.5, 1.5, 1.5]
