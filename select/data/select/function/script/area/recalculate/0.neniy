use select

// Coordinates for area beginning
scb players opr #start_x select.data = #pos1_x
scb players opr #start_y select.data = #pos1_y
scb players opr #start_z select.data = #pos1_z
scb players opr #start_x select.data < #pos2_x
scb players opr #start_y select.data < #pos2_y
scb players opr #start_z select.data < #pos2_z

// Calculating the scale
scb players opr #scale_x select.data = #pos1_x
scb players opr #scale_y select.data = #pos1_y
scb players opr #scale_z select.data = #pos1_z
scb players opr #scale_x select.data > #pos2_x
scb players opr #scale_y select.data > #pos2_y
scb players opr #scale_z select.data > #pos2_z

ex store storage select.storage x1 int 1 run scb players get #start_x select.data
ex store storage select.storage y1 int 1 run scb players get #start_y select.data
ex store storage select.storage z1 int 1 run scb players get #start_z select.data
ex store storage select.storage x2 int 1 run scb players get #scale_x select.data
ex store storage select.storage y2 int 1 run scb players get #scale_y select.data
ex store storage select.storage z2 int 1 run scb players get #scale_z select.data

ex as @a[tag=spectator, sort=nearest] run fn script/area_pos select.storage

scb players opr #scale_x select.data -= #start_x
scb players opr #scale_y select.data -= #start_y
scb players opr #scale_z select.data -= #start_z

scb players opr #scale_x select.data *= #thousand
scb players opr #scale_y select.data *= #thousand
scb players opr #scale_z select.data *= #thousand
scb players add #scale_x select.data 1010
scb players add #scale_y select.data 1010
scb players add #scale_z select.data 1010
